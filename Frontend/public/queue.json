{
  "questionName": "Sliding Window Maximum (Monotonic Queue)",
  "patternType": "queue",
  "sampleInput": {
    "nums": [1,3,-1,-3,5,3,6,7],
    "k": 3
  },
  "sampleOutput": [3,3,5,5,6,7],

  "visualLayout": {
    "structures": [
      {
        "id": "queue1",
        "type": "queue",
        "label": "Monotonic Queue (Indices)",
        "data": []
      },
      {
        "id": "windowMax",
        "type": "variable",
        "label": "Current Window Maximum",
        "value": null
      },
      {
        "id": "i",
        "type": "variable",
        "label": "Current Index",
        "value": 0
      }
    ]
  },

  "steps": [
    {
      "step": 1,
      "action": "enqueue",
      "message": "Start processing index 0 → push 1.",
      "stateChange": {
        "queue1": [0],
        "i": 0,
        "windowMax": 1
      }
    },
    {
      "step": 2,
      "action": "enqueue",
      "message": "Push 3 at index 1 → remove smaller 1.",
      "condition": {
        "expression": "3 > nums[queue.back()]",
        "result": true
      },
      "stateChange": {
        "queue1": [1],
        "i": 1,
        "windowMax": 3
      }
    },
    {
      "step": 3,
      "action": "enqueue",
      "message": "Push -1 (index 2). Queue: [1,2].",
      "stateChange": {
        "queue1": [1,2],
        "i": 2,
        "windowMax": 3
      }
    },
    {
      "step": 4,
      "action": "compare",
      "message": "Window [0,2] complete → record max = 3.",
      "stateChange": {
        "windowMax": 3
      }
    },
    {
      "step": 5,
      "action": "dequeue",
      "message": "Move to index 3 (value -3). Remove index 1 (out of window).",
      "stateChange": {
        "queue1": [2,3],
        "i": 3
      }
    },
    {
      "step": 6,
      "action": "enqueue",
      "message": "Push 5 (index 4), remove smaller -3.",
      "condition": {
        "expression": "5 > nums[queue.back()]",
        "result": true
      },
      "stateChange": {
        "queue1": [4],
        "i": 4,
        "windowMax": 5
      }
    },
    {
      "step": 7,
      "action": "mark",
      "message": "✅ Final sliding window max values = [3,3,5,5,6,7].",
      "stateChange": {}
    }
  ],

  "endMessage": "🧮 Monotonic queue processing complete — window max values computed.",

  "actionReference": {
    "enqueue": "Push element index into queue, maintaining decreasing order.",
    "dequeue": "Remove elements that are out of current window.",
    "compare": "Compare and remove smaller elements from back.",
    "update": "Update window maximum.",
    "mark": "Record final result."
  }
}
